[Desktop Entry]
Type=Application
Name=Screenshots
Name[ru]=Скриншоты
GenericName=Screenshot and annotation
GenericName[ru]=Скриншот и разметка
Comment=Screen capture with arrows, text, blur and crop
Comment[ru]=Снимок экрана со стрелками, текстом, размытием и обрезкой
Exec=@CMAKE_INSTALL_FULL_BINDIR@/glide-shot %f
Icon=glide-shot
Terminal=false
StartupWMClass=glide-shot
Categories=Graphics;Utility;
Keywords=скриншот;снимок;экран;стрелка;разметка;screenshot;annotate;
MimeType=image/png;image/jpeg;image/webp;
Actions=region;window;screen;

[Desktop Action region]
Name=Capture area
Name[ru]=Снять область
Exec=@CMAKE_INSTALL_FULL_BINDIR@/glide-shot --capture region

[Desktop Action window]
Name=Capture window
Name[ru]=Снять окно
Exec=@CMAKE_INSTALL_FULL_BINDIR@/glide-shot --capture window

[Desktop Action screen]
Name=Capture full screen
Name[ru]=Снять весь экран
Exec=@CMAKE_INSTALL_FULL_BINDIR@/glide-shot --capture screen
