[Desktop Entry]
Type=Application
Name=Архивы
GenericName=Архиватор
Comment=Открыть, распаковать и создать архив: zip, 7z, rar, tar
Exec=@CMAKE_INSTALL_FULL_BINDIR@/glide-archive %F
Icon=glide-archive
Terminal=false
StartupWMClass=glide-archive
Categories=Utility;Archiving;Compression;
Keywords=архив;распаковать;упаковать;сжать;zip;7z;rar;tar;archive;extract;
MimeType=application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-lz4-compressed-tar;application/x-lzma-compressed-tar;application/gzip;application/x-gzip;application/x-xz;application/zstd;application/x-bzip2;application/x-bzip;application/x-lz4;application/x-lzma;application/x-cpio;application/x-iso9660-image;application/vnd.ms-cab-compressed;application/x-cd-image;application/java-archive;application/vnd.comicbook+zip;application/vnd.comicbook-rar;application/x-cbr;application/x-cbz;application/x-archive;application/x-lha;
Actions=extract;

[Desktop Action extract]
Name=Распаковать сюда
Exec=@CMAKE_INSTALL_FULL_BINDIR@/glide-archive --extract-here %F
